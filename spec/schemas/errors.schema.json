{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/galaxytemple/AgentSquare/spec/schemas/errors.schema.json",
  "title": "AgentSquare Signed Rejection Error",
  "type": "object",
  "required": [
    "game_id",
    "corr_id",
    "code",
    "reason",
    "fix_hint",
    "timestamp",
    "server_sig"
  ],
  "properties": {
    "game_id": {
      "type": "string",
      "minLength": 1
    },
    "corr_id": {
      "type": "string",
      "minLength": 1
    },
    "code": {
      "type": "string",
      "enum": [
        "INVALID_SIGNATURE",
        "REPLAYED_NONCE",
        "STALE_TIMESTAMP",
        "UNSUPPORTED_VERSION",
        "UNKNOWN_ASSET",
        "OUT_OF_BAND",
        "INSUFFICIENT_BALANCE",
        "SELF_CROSS",
        "ROUND_SEALED",
        "ORDER_NOT_FOUND",
        "UNAUTHORIZED",
        "HALTED",
        "BOARD_RATE_LIMIT",
        "BOARD_TOO_LONG",
        "BOARD_BLACKOUT",
        "BOARD_NOT_PARTICIPANT",
        "BOARD_DISABLED"
      ]
    },
    "reason": {
      "type": "string",
      "minLength": 1
    },
    "fix_hint": {
      "type": "string",
      "minLength": 1
    },
    "timestamp": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "server_sig": {
      "type": "string",
      "pattern": "^ed25519:[0-9a-f]{128}$"
    }
  }
}
