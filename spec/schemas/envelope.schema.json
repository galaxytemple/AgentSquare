{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/galaxytemple/AgentSquare/spec/schemas/envelope.schema.json",
  "title": "AgentSquare Signed Message Envelope",
  "type": "object",
  "required": [
    "version",
    "game_id",
    "from",
    "to",
    "type",
    "timestamp",
    "nonce",
    "corr_id",
    "payload",
    "signature"
  ],
  "properties": {
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+$"
    },
    "game_id": {
      "type": "string",
      "minLength": 1
    },
    "from": {
      "type": "string",
      "minLength": 1
    },
    "to": {
      "type": "string",
      "minLength": 1
    },
    "type": {
      "type": "string",
      "enum": [
        "agent.register",
        "key.rotate",
        "place_order",
        "cancel_order",
        "replace_order",
        "fill",
        "settle",
        "quote",
        "board.post",
        "board.retract",
        "admin.halt",
        "admin.resume",
        "admin.moderate",
        "manifest.update"
      ]
    },
    "timestamp": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "nonce": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "corr_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "critical": {
      "type": "array",
      "items": { "type": "string" }
    },
    "payload": {
      "type": "object"
    },
    "signature": {
      "type": "string",
      "pattern": "^ed25519:[0-9a-f]{128}$"
    }
  }
}
